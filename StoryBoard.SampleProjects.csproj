<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageId>StoryBoard.SampleProjects</PackageId>
    <Version>1.0.1</Version>
    <Authors>StoryBoard</Authors>
    <Description>Sample StoryBoard projects and source assets for testing.</Description>
    <PackageTags>storyboard;sample;testing;assets</PackageTags>
    <PackageReadmeFile>README.SampleProjects.md</PackageReadmeFile>

    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Samples\**\*"
          Pack="true"
          PackagePath="contentFiles\any\any\Samples\%(RecursiveDir)%(Filename)%(Extension)"
          PackageCopyToOutput="true"
          PackageFlatten="false" />
    <None Include="README.SampleProjects.md"
          Pack="true"
          PackagePath="README.SampleProjects.md" />
  </ItemGroup>

</Project>
