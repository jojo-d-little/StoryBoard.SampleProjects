<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageId>StoryBoard.SampleProjects</PackageId>
    <Version>1.0.8</Version>
    <NuspecFile>StoryBoard.SampleProjects.nuspec</NuspecFile>
    <NuspecProperties>PackageVersion=$(PackageVersion)</NuspecProperties>
    <Authors>StoryBoard</Authors>
    <Description>Sample StoryBoard projects and source assets for testing.</Description>
    <PackageTags>storyboard;sample;testing;assets</PackageTags>
    <PackageReadmeFile>README.SampleProjects.md</PackageReadmeFile>

    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

</Project>
